{
  "name": "anishshobithps.com",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=web",
    "start": "turbo run start --filter=web",
    "lint": "turbo run lint",
    "lint:ws": "sherif",
    "test": "turbo run test",
    "test:watch": "pnpm --filter web run test:watch",
    "types:check": "turbo run types:check",
    "knip": "knip --config knip.config.mjs",
    "db:migrate": "pnpm --filter web run db:migrate",
    "db:push": "pnpm --filter web run db:push",
    "db:studio": "pnpm --filter web run db:studio",
    "db:seed:guestbook": "pnpm --filter web run db:seed:guestbook",
    "db:seed:guestbook:cleanup": "pnpm --filter web run db:seed:guestbook:cleanup",
    "db:seed:links": "pnpm --filter web run db:seed:links",
    "spotify:token": "pnpm --filter web run spotify:token",
    "banners": "pnpm --filter web run banners"
  },
  "devDependencies": {
    "knip": "^6.41.0",
    "sherif": "^1.13.0",
    "turbo": "^2.11.10"
  }
}
